# GEMINI_API_KEY: Required for Gemini AI API calls (Photo Scanner & Universal Food Chatbot).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Local Node.js Express server port (default: 3000)
PORT=3000

# APP_URL: The URL where this applet is hosted (default: http://localhost:3000 for local work)
APP_URL="http://localhost:3000"

# OPTIONAL DATABASE CONFIG:
# If SQL_HOST is omitted when running locally, server.ts automatically uses the built-in
# Local Node.js In-Memory Nutrition Store with zero setup required.
# SQL_HOST="localhost"
# SQL_USER="postgres"
# SQL_PASSWORD=""
# SQL_DB_NAME="foodlens"
